# ReclaimAI Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://reclaim:reclaim_dev_password@localhost:5432/reclaim
JWT_SECRET_KEY=dev-secret-key-change-me-in-production-must-be-256-bits
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=dev-ai-service-key-change-me
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
