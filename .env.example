<![CDATA[# ============================================================================
# ReclaimAI — Root Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# This file is loaded by docker-compose.yml.
# ============================================================================

# --- Project ---
COMPOSE_PROJECT_NAME=reclaim-ai

# --- PostgreSQL ---
POSTGRES_USER=reclaim
POSTGRES_PASSWORD=reclaim_dev_password_change_me
POSTGRES_DB=reclaim
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://reclaim:reclaim_dev_password_change_me@postgres:5432/reclaim
JWT_SECRET_KEY=dev-secret-key-change-me-in-production-must-be-256-bits
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AI_SERVICE_URL=http://ai_service:8001
AI_SERVICE_API_KEY=dev-ai-service-key-change-me
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- AI Service ---
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_DIR=/app/indexes
MODEL_CACHE_DIR=/app/model_cache
MATCH_WEIGHT_IMAGE=0.35
MATCH_WEIGHT_TEXT=0.30
MATCH_WEIGHT_LOCATION=0.20
MATCH_WEIGHT_TIME=0.15
MATCH_SCORE_THRESHOLD=40
AI_SERVICE_PORT=8001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
]]>
